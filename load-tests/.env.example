# Copy this file to a local, ignored environment file before running any load-test command.
# Never commit real Supabase keys, admin tokens, session IDs, or production URLs.

LOAD_TEST_TARGET_URL=https://your-staging-preview.example.com
LOAD_TEST_BASE_URL=https://your-staging-preview.example.com
LOAD_TEST_ALLOWED_HOST=your-staging-preview.example.com
LOAD_TEST_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
LOAD_TEST_SUPABASE_ANON_KEY=YOUR_STAGING_SUPABASE_ANON_KEY
LOAD_TEST_EVENT_ID=00000000-0000-0000-0000-000000000000
LOAD_TEST_SESSION_ID=
LOAD_TEST_ADMIN_TOKEN=
LOAD_TEST_ADMIN_USER_ID=
LOAD_TEST_ENVIRONMENT=staging
LOAD_TEST_AUTH_MODE=anon
LOAD_TEST_RUN_ID=loadtest-local-dry-run

# Write and high-load gates.
LOAD_TEST_WRITE_ENABLED=false
LOAD_TEST_PARTICIPANT_GENERATION_ENABLED=false
LOAD_TEST_CONFIRM_HIGH_LOAD=false
LOAD_TEST_LOWER_STAGES_PASSED=false
LOAD_TEST_CONFIRMED=

# Optional staging-only privileged operations. Never use production credentials here.
LOAD_TEST_SUPABASE_ACCESS_TOKEN=
LOAD_TEST_SUPABASE_SERVICE_ROLE_KEY=
LOAD_TEST_ADMIN_WRITE_ENABLED=false
LOAD_TEST_ADMIN_PUBLICATION_ENABLED=false
LOAD_TEST_WORKER_INVOCATION_ENABLED=false

# Optional behavior controls.
LOAD_TEST_DURATION=
LOAD_TEST_MAX_VUS=
LOAD_TEST_HEARTBEAT_INTERVAL_SECONDS=3
LOAD_TEST_MESSAGE_FETCH_EVERY=1
LOAD_TEST_LISTENER_COUNT_EVERY=20
LOAD_TEST_MESSAGE_PAGE_LIMIT=200
LOAD_TEST_INCLUDE_PAGE_LOAD=true
LOAD_TEST_AUDIO_PROBE_ENABLED=false
LOAD_TEST_REALTIME_ENABLED=false
LOAD_TEST_REALTIME_WORKERS=4
LOAD_TEST_RECOVERY_JITTER_MS=1000

# Optional profile tuning.
LOAD_TEST_PASSIVE_PCT=0.70
LOAD_TEST_LIGHT_PCT=0.20
LOAD_TEST_ACTIVE_PCT=0.08
LOAD_TEST_PEAK_PCT=0.02
LOAD_TEST_PEAK_FIRST_SUBMIT_PCT=0.10
LOAD_TEST_PEAK_SECOND_SUBMIT_PCT=0.03
LOAD_TEST_PEAK_THIRD_SUBMIT_PCT=0.01
LOAD_TEST_PEAK_WINDOW_SECONDS=30
LOAD_TEST_PEAK_STARTS_AFTER_SECONDS=120
