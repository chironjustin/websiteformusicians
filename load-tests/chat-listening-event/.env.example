# Required for all scenarios.
LOAD_TEST_BASE_URL=http://localhost:5173
LOAD_TEST_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
LOAD_TEST_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
LOAD_TEST_EVENT_ID=00000000-0000-0000-0000-000000000000
LOAD_TEST_ENVIRONMENT=local
LOAD_TEST_AUTH_MODE=anon

# Required for scenarios that write data or run at high concurrency.
LOAD_TEST_WRITE_ENABLED=false
LOAD_TEST_CONFIRMED=

# Required only for approved production tests.
LOAD_TEST_PRODUCTION_OVERRIDE=

# Optional authenticated/admin scenarios only. Never commit real values.
LOAD_TEST_SUPABASE_ACCESS_TOKEN=
LOAD_TEST_SUPABASE_SERVICE_ROLE_KEY=
LOAD_TEST_ADMIN_WRITE_ENABLED=false
LOAD_TEST_WORKER_INVOCATION_ENABLED=false

# Optional behavior controls.
LOAD_TEST_RUN_ID=
LOAD_TEST_DURATION=
LOAD_TEST_MAX_VUS=
LOAD_TEST_HEARTBEAT_INTERVAL_SECONDS=3
LOAD_TEST_LISTENER_COUNT_EVERY=20
LOAD_TEST_INCLUDE_PAGE_LOAD=true
LOAD_TEST_AUDIO_PROBE_ENABLED=false
LOAD_TEST_REALTIME_ENABLED=false

# Optional profile tuning.
LOAD_TEST_PASSIVE_PCT=0.70
LOAD_TEST_LIGHT_PCT=0.20
LOAD_TEST_ACTIVE_PCT=0.08
LOAD_TEST_PEAK_PCT=0.02
LOAD_TEST_PEAK_FIRST_SUBMIT_PCT=0.10
LOAD_TEST_PEAK_SECOND_SUBMIT_PCT=0.03
LOAD_TEST_PEAK_THIRD_SUBMIT_PCT=0.01
LOAD_TEST_PEAK_WINDOW_SECONDS=30
LOAD_TEST_PEAK_STARTS_AFTER_SECONDS=120
